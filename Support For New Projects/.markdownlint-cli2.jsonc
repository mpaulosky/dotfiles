// markdownlint-cli2 config shared by the Lint Markdown workflow and the
// pre-commit and pre-push hooks. The rules are in .github/instructions/markdown.instructions.md.
{
  "config": {
    "default": true,
    // Lines up to 200 characters; tables and code blocks can't wrap.
    "MD013": { "line_length": 200, "tables": false, "code_blocks": false },
    // Instruction files carry an applyTo front matter title as well as an H1.
    "MD025": { "front_matter_title": "" }
  },
  "ignores": [
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/.pytest_cache/**",
    "team-docs/**",
    // Generated by the release workflow from PR bodies.
    "docs/blogs/**"
  ]
}
