.directory

# Left by local test.sh runs; apply.sh never copies them.
__pycache__/
.pytest_cache/

# JetBrains IDE (Rider) project settings, local to each machine.
.idea/

# Sandcastle's pnpm packages.
node_modules/

# The review's local record of security findings (scripts/review.sh record): never
# committed or published. Its README can be committed.
.security/*
!.security/README.md
